# Copy this file to .env and fill in values. Never commit real secrets.
# The API reads .env from the repo root. The web app reads NEXT_PUBLIC_* vars.

# --- Web ---
NEXT_PUBLIC_USE_MOCK=true
NEXT_PUBLIC_API_BASE=http://localhost:8000

# --- API / replay ---
DB_PATH=./data/app.db

# --- n8n alerts ---
N8N_WEBHOOK_URL=http://localhost:5678/webhook/alert-notify
ALERT_SECRET=change-me

# --- LLM (chat agent) ---
LLM_PROVIDER=groq
GROQ_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# --- Telegram (used by n8n, not by Python) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
